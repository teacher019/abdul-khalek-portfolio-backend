{
    "variable":  [
                     {
                         "key":  "baseUrl",
                         "value":  "https://abdul-khalek-portfolio-backend.onrender.com"
                     },
                     {
                         "key":  "postSlug",
                         "value":  "my-first-blog-post"
                     },
                     {
                         "key":  "projectId",
                         "value":  "1"
                     }
                 ],
    "info":  {
                 "description":  "Portfolio, projects, blog search, category filter and moderated comments API.",
                 "name":  "Abdul Khalek Portfolio API",
                 "schema":  "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
             },
    "item":  [
                 {
                     "name":  "Profile",
                     "request":  {
                                     "method":  "GET",
                                     "url":  "{{baseUrl}}/api/profile/"
                                 }
                 },
                 {
                     "name":  "Get All Projects",
                     "request":  {
                                     "method":  "GET",
                                     "url":  "{{baseUrl}}/api/projects/"
                                 }
                 },
                 {
                     "name":  "Get Project Details",
                     "request":  {
                                     "method":  "GET",
                                     "url":  "{{baseUrl}}/api/projects/{{projectId}}/"
                                 }
                 },
                 {
                     "name":  "Get All Published Blog Posts",
                     "request":  {
                                     "method":  "GET",
                                     "url":  "{{baseUrl}}/api/blog/"
                                 }
                 },
                 {
                     "name":  "Search Blog Posts",
                     "request":  {
                                     "method":  "GET",
                                     "url":  "{{baseUrl}}/api/blog/?search=web"
                                 }
                 },
                 {
                     "name":  "Filter Blog by Category",
                     "request":  {
                                     "method":  "GET",
                                     "url":  "{{baseUrl}}/api/blog/?category=Web%20Development"
                                 }
                 },
                 {
                     "name":  "Get Blog Post Details",
                     "request":  {
                                     "method":  "GET",
                                     "url":  "{{baseUrl}}/api/blog/{{postSlug}}/"
                                 }
                 },
                 {
                     "name":  "Get Approved Comments",
                     "request":  {
                                     "method":  "GET",
                                     "url":  "{{baseUrl}}/api/blog/{{postSlug}}/comments/"
                                 }
                 },
                 {
                     "name":  "Submit Comment for Moderation",
                     "request":  {
                                     "url":  "{{baseUrl}}/api/blog/{{postSlug}}/comments/",
                                     "method":  "POST",
                                     "body":  {
                                                  "raw":  "{\n  \"name\": \"Demo Visitor\",\n  \"email\": \"visitor@example.com\",\n  \"message\": \"This is a test comment for moderation.\"\n}",
                                                  "options":  {
                                                                  "raw":  {
                                                                              "language":  "json"
                                                                          }
                                                              },
                                                  "mode":  "raw"
                                              },
                                     "header":  [
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ]
                                 }
                 }
             ]
}
